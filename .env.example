# Supabase project -> Settings -> API. Only the public (anon / publishable) key
# belongs here. NEVER put the service_role / secret key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used for canonical URLs, sitemap and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: full profile URLs for the Contact page
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_BEHANCE_URL=
NEXT_PUBLIC_PINTEREST_URL=
